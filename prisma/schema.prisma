generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

enum OrderFailureCode {
  INSUFFICIENT_STOCK
  PROCESSING_ATTEMPTS_EXHAUSTED
}

model Order {
  id                       String            @id @default(uuid())
  customerId               String
  idempotencyKey           String
  requestHash              String
  status                   OrderStatus       @default(PENDING)
  totalAmount              Decimal           @db.Decimal(12, 2)
  currencyCode             String            @default("INR") @db.Char(3)
  processingAttemptCount   Int               @default(0)
  processingLeaseExpiresAt DateTime?         @db.Timestamptz(3)
  failureCode              OrderFailureCode?
  failureMessage           String?
  completedAt              DateTime?         @db.Timestamptz(3)
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)

  items        OrderItem[]
  reservations InventoryReservation[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([status, processingLeaseExpiresAt])
}

model Product {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  currentPrice Decimal  @db.Decimal(12, 2)
  currencyCode String   @default("INR") @db.Char(3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  inventory    Inventory?
  orderItems   OrderItem[]
  reservations InventoryReservation[]
}

model Inventory {
  productId        String   @id
  onHandQuantity   Int
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}

model InventoryReservation {
  id        String            @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([orderId, status])
  @@index([productId, status])
}
